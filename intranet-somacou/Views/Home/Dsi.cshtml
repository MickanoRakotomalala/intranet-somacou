@{
    ViewBag.Title = "Intranet";
}
<main>
    <div class="container-fluid">
        <div class="container-fluid">
            <img src="~/Assets/DSI.PNG" alt="DSI"/>
        </div>
        @*<h3>@ViewBag.Message</h3>*@
        <div class="row">
            <div class="col-md-2">
                <div>
                    <h5><i class="bi bi-box me-2"></i><span type="button" data-bs-toggle="collapse" data-bs-target="#dsi" aria-expanded="false" aria-controls="dsi">DSI</span></h5>
                    <ul class="collapse" id="dsi">
                        <li><i class="bi bi-textarea me-2"></i>Informations</li>
                        <li><i class="bi bi-list-task me-2"></i>Rôle</li>
                    </ul>
                </div>
                <div>
                    <h5><i class="bi bi-pc-display-horizontal me-2"></i><span type="button" data-bs-toggle="collapse" data-bs-target="#soft_hard" aria-expanded="false" aria-controls="soft_hard">Software / Hardware</span></h5>
                    <ul class="collapse" id="soft_hard">
                        <li><i class="bi bi-file-text me-2"></i>Détails</li>
                        <li><i class="bi bi-gear me-2"></i>Responsabilité</li>
                    </ul>
                </div>
                <div>
                    <h5><i class="bi bi-shield-lock me-2"></i><span type="button" data-bs-toggle="collapse" data-bs-target="#security" aria-expanded="false" aria-controls="security">Sécurité Informatique</span></h5>
                    <ul class="collapse" id="security">
                        <li><i class="bi bi-file-text me-2"></i>Détails</li>
                        <li><i class="bi bi-gear me-2"></i>Résponsabilité</li>
                    </ul>
                </div>
                <div>
                    <h5><i class="bi bi-code-square me-2"></i><span type="button" data-bs-toggle="collapse" data-bs-target="#dev" aria-expanded="false" aria-controls="dev">Développement / Applicatif</span></h5>
                    <ul class="collapse" id="dev">
                        <li><i class="bi bi-file-text me-2"></i>Détails</li>
                        <li><i class="bi bi-gear me-2"></i>Responsabilité</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-9">

            </div>
        </div>
    </div>
</main>