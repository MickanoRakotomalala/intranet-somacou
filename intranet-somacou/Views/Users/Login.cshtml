
@{
    ViewBag.Title = "Login";
}


<div class="container-fluid">
    <div class="offset-lg-4 col-lg-4 offset-lg-4 offset-md-4 col-md-4 offset-md-4 col-sm-12 login">
        <form action="/" method="post">
            <h5>Se connecter</h5>
            <input class="form-control" type="email" placeholder="Entrer votre Email" />
            <input class="form-control" type="password" placeholder="Entrer votre Mot de passe" />
            <Button type="submit" class="btn btn-outline-primary">Se connecter</Button>
        </form>
    </div>
</div>

