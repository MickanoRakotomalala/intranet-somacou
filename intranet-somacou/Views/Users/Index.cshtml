@model IEnumerable<intranet_somacou.Models.RegisterDto>

@{
    ViewBag.Title = "Users";
}

<div class="container User">
    @if (TempData["SuccessMessage"] != null)
     {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>@TempData["SuccessMessage"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
     }
    <h2>Liste Utilisateur</h2>
    <div class="table-responsive-sm">
        <table class="table table-responsive-sm">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Matricule</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Adresse</th>
                    <th>Poste</th>
                    <th>Role</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Name</td>
                        <td>@user.Matricule</td>
                        <td>@user.Email</td>
                        <td>@user.Phone</td>
                        <td>@user.Address</td>
                        <td>@user.Poste</td>
                        <td>
                            @{
                                var roles = user.Role;
                                var rolesStr = string.Join(",", roles);

                                string color = "bg-secondary";
                                if (roles.Contains("Admin"))
                                {
                                    color = "bg-danger";
                                    ;
                                }
                                else if (roles.Contains("Chef"))
                                {
                                    color = "bg-primary";
                                }
                                else if (roles.Contains("User"))
                                {
                                    color = "bg-warning text-dark";
                                }

                                <span class="badge rounded-pill @color">@rolesStr</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a href="/Users/Details/@user.Id"><i class="bi bi-pencil-square"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>


    </div>
    <div class="d-flex justify-content-between align-items-center">
       <p>Page @ViewBag.CurrentPage de @ViewBag.TotalPages</p>
    </div>
</div>

        <nav aria-label="Page navigation" class="container paginationUsers">
            <ul class="pagination">
                @if (ViewBag.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1 })">Précédent</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">Précédent</span>
                    </li>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                    </li>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1 })">Suivant</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">Suivant</span>
                    </li>
                }
            </ul>
        </nav>

