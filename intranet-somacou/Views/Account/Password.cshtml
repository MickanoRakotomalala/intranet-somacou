@model intranet_somacou.Models.PasswordDto
@{
    ViewBag.Title = "Password";
}

    <div class="container-fluid text-white col-md-4 mx-auto PasswordUpdate">
            <h3 class="text-white">Modifier le Mot de passe</h3>
            <form action="/Account/Password" method="post">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>@TempData["ErrorMessage"]</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                <div class="row mb-2">
                    <label class="col-sm-4 col-form-label" for="CurrentPassword">Ancien :</label>
                    <div class="col-sm-8">
                        <input type="password" name="CurrentPassword" id="CurrentPassword" class="form-control" value="@Request.Form["CurrentPassword"]" />
                        <span class="text-white">
                            @if(ViewBag.ErrorMessage != null)
                            {
                                @ViewBag.ErrorMessage
                            }
                        </span>
                        <span class="text-white">@Html.ValidationMessageFor(m => m.CurrentPassword) </span>
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="col-sm-4 col-form-label" for="NewPassword">Nouveau :</label>
                    <div class="col-sm-8">
                        <input type="password" name="NewPassword" id="NewPassword" class="form-control" value="@Request.Form["NewPassword"]" />
                        <span class="text-white">@Html.ValidationMessageFor(m => m.NewPassword)</span>
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="col-sm-4 col-form-label" for="ConfirmPassword">Confirmation :</label>
                    <div class="col-sm-8">
                        <input type="password" name="ConfirmPassword" id="ConfirmPassword" class="form-control" value="@Request.Form["ConfirmPassword"]" />
                        <span class="text-white">@Html.ValidationMessageFor(m => m.ConfirmPassword)</span>
                    </div>
                </div>
                <div class="row mb-2">
                       <button type="submit" class="btn btn-outline-success offset-sm-5 col-sm-3" >Appliquer</button>
                       <a href="/Account/Profile" class="btn btn-outline-light offset-sm-1 col-sm-2">Retour</a>
                </div>
            </form>
    </div>
