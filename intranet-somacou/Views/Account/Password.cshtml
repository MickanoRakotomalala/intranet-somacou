@model intranet_somacou.Models.PasswordDto
@{
    ViewBag.Title = "Password";
}

<div class="container col-md-4 mx-auto text-white" style="background-color:#F16476;">
    <div class="modal-header">
        <h2 class="modal-title fs-5 text-white">Modifier le Mot de passe</h2>
    </div>
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>@TempData["ErrorMessage"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    else if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>@TempData["SuccessMessage"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="modal-body ProfilUpdate">
        <form action="/Account/Password" method="post">
            <input type="hidden" name="Id" />
            <div class="row mb-2">
                <label class="col-sm-4 col-form-label">Ancien :</label>
                <div class="col-sm-8">
                    <input type="text" name="Password" id="Password" class="form-control" required />
                </div>
            </div>
            <div class="row mb-2">
                <label class="col-sm-4 col-form-label">Nouveau :</label>
                <div class="col-sm-8">
                    <input type="password" name="NewPwd" id="NewPwd" class="form-control" required />
                </div>
            </div>
            <div class="row mb-2">
                <label class="col-sm-4 col-form-label">Confirmation :</label>
                <div class="col-sm-8">
                    <input type="password" name="ConfirmPwd" id="ConfirmPwd" class="form-control" required />
                </div>
            </div>
            <button type="submit" class="btn btn-outline-secondary">Appliquer</button>
        </form>
    </div>
</div>

