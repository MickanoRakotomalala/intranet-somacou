@model intranet_somacou.Models.PasswordDto
@{
    ViewBag.Title = "Password";
}

    <div class="container-fluid text-white col-md-4 mx-auto PasswordUpdate">
        <div class="container-fluid p-2">
            <h3 class="text-white">Modifier le Mot de passe</h3>
            <form action="/Account/Password" method="post">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>@TempData["ErrorMessage"]</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                <div class="row mb-4">
                    <label class="col-sm-4 col-form-label" for="CurrentPassword">Ancien :</label>
                    <div class="col-sm-8">
                        <input type="password" name="CurrentPassword" id="CurrentPassword" class="form-control" value="@Request.Form["CurrentPassword"]" required />
                    </div>
                </div>
                <div class="row mb-4">
                    <label class="col-sm-4 col-form-label" for="NewPassword">Nouveau :</label>
                    <div class="col-sm-8">
                        <input type="password" name="NewPassword" id="NewPassword" class="form-control" value="@Request.Form["NewPassword"]" required />
                    </div>
                </div>
                <div class="row mb-4">
                    <label class="col-sm-4 col-form-label" for="ConfirmPassword">Confirmation :</label>
                    <div class="col-sm-8">
                        <input type="password" name="ConfirmPassword" id="ConfirmPassword" class="form-control" value="@Request.Form["ConfirmPassword"]" required />
                    </div>
                </div>
                <div class="row offset-sm-6 col-sm-4">
                       <button type="submit" class="btn btn-outline-secondary">Appliquer</button>
                </div>
            </form>
        </div>
    </div>
