@model intranet_somacou.Models.RegisterDto
@{
    ViewBag.Title = "Profile";
}

<div class="container">
    <div class="col-md-6 mx-auto p-4 Profile">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>@TempData["ErrorMessage"]</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>@TempData["SuccessMessage"]</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <h2>Profil</h2>
        <hr />

        <div class="row mb-2">
            <div class="col-sm-3">Nom :</div>
            <div class="col-sm-9" name="Name">@Model.Name</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3">Matricule :</div>
            <div class="col-sm-9" name="Matricule">@Model.Matricule</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3">Email :</div>
            <div class="col-sm-9" name="Email">@Model.Email</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3">Phone :</div>
            <div class="col-sm-9" name="Phone">@Model.Phone</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3">Adresse :</div>
            <div class="col-sm-9" name="Address">@Model.Address</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3">Poste :</div>
            <div class="col-sm-9" name="Poste">@Model.Poste</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3">Rôle :</div>
            <div class="col-sm-9" name="Role">@Model.Role</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3">Date :</div>
            <div class="col-sm-9" name="CreatedAt">@Model.CreatedAt</div>
        </div>
        <hr />
        <div>
            <button type="button" class="btn btn-outline-light" data-bs-toggle="modal" data-bs-target="#EditProfileModal">
                Editer Profil
            </button>
            <a class="btn btn-outline-warning" href="/Account/Password/@Model.Id">
                Editer Mot de passe
            </a>
        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="EditProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content text-white" style="background-color:#F16476;">
            <div class="modal-header">
                <h2 class="modal-title fs-5">Editer mon Profil</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body ProfilUpdate">
                <form action="/Account/Profile" method="post">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <div class="row mb-2">
                        <label class="col-sm-4 col-form-label">Nom :</label>
                        <div class="col-sm-8">
                            <input type="text" name="name" id="Name" placeholder="Nom" class="form-control" value="@Model.Name" required />
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label class="col-sm-4 col-form-label">Matricule :</label>
                        <div class="col-sm-8">
                            <input type="number" name="Matricule" id="Matricule" placeholder="Matricule" class="form-control" value="@Model.Matricule" required />
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label class="col-sm-4 col-form-label">Email :</label>
                        <div class="col-sm-8">
                            <input type="text" name="Email" id="Email" placeholder="Email" class="form-control" value="@Model.Email" required />
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label class="col-sm-4 col-form-label">Téléphone :</label>
                        <div class="col-sm-8">
                            <input type="text" name="phone" id="Phone" placeholder="Phone" class="form-control" value="@Model.Phone" required />
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label class="col-sm-4 col-form-label">Adresse :</label>
                        <div class="col-sm-8">
                            <input type="text" name="Address" id="Address" placeholder="Adresse" class="form-control" value="@Model.Address" required />
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label class="col-sm-4 col-form-label">Poste :</label>
                        <div class="col-sm-8">
                            <select name="Poste" class="form-control" id="Poste">
                                @{ foreach (var poste in ViewBag.Poste)
                                    {
                                        <option value="@poste" @(poste == Model.Poste ? "selected" : "")>@poste</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-outline-secondary">Sauvegarder</button>
                </form>
            </div>
        </div>
    </div>
</div>
