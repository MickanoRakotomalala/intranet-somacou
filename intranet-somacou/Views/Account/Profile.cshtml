@model intranet_somacou.Models.RegisterDto
@{
    ViewBag.Title = "Profile";
}

<div class="container">
    <div class="col-md-6 mx-auto p-4 Profile">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>@TempData["ErrorMessage"]</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>@TempData["SuccessMessage"]</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <h2>Profil</h2>
        <hr />

        <div class="row mb-2">
            <div class="col-sm-3">Nom :</div>
            <div class="col-sm-9" name="Name">@Model.Name</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3">Matricule :</div>
            <div class="col-sm-9" name="Matricule">@Model.Matricule</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3">Email :</div>
            <div class="col-sm-9" name="Email">@Model.Email</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3">Phone :</div>
            <div class="col-sm-9" name="Phone">@Model.Phone</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3">Adresse :</div>
            <div class="col-sm-9" name="Address">@Model.Address</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3">Poste :</div>
            <div class="col-sm-9" name="Poste">@Model.Poste</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3">Role :</div>
            <div class="col-sm-9" name="Role">@Model.Role</div>
        </div>
        <div class="row mb-2">
            <div class="col-sm-3">Date :</div>
            <div class="col-sm-9" name="CreatedAt">@Model.CreatedAt</div>
        </div>
        <hr />
        <div>
            <a class="btn btn-outline-light" href="/Account/EditProfile">Editer Profil</a>
            <a class="btn btn-outline-warning" href="#">Editer Mot de passe</a>
        </div>
    </div>
</div>

