@model intranet_somacou.Models.RegisterDto
@{
    ViewBag.Title = "Profile";
}

<div class="container">
    <div class="col-lg-6 col-md-8 mx-auto p-4 Profile">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>@TempData["ErrorMessage"]</strong>
                @if (ViewBag.Errors != null)
                {
                    <ul class="text-danger">
                        @foreach (var error in ViewBag.Errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                }
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>@TempData["SuccessMessage"]</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <h2>Profil</h2>
        <hr />

        <div class="row mb-2">
            <div class="col-3">Nom :</div>
            <div class="col-9" name="Name">@Model.Name</div>
        </div>
        <div class="row mb-2">
            <div class="col-3">Matricule :</div>
            <div class="col-9" name="Matricule">@Model.Matricule</div>
        </div>
        <div class="row mb-2">
            <div class="col-3">Email :</div>
            <div class="col-9" name="Email">@Model.Email</div>
        </div>
        <div class="row mb-2">
            <div class="col-3">Phone :</div>
            <div class="col-9" name="Phone">@Model.Phone</div>
        </div>
        <div class="row mb-2">
            <div class="col-3">Adresse :</div>
            <div class="col-9" name="Address">@Model.Address</div>
        </div>
        <div class="row mb-2">
            <div class="col-3">Poste :</div>
            <div class="col-9" name="Poste">@Model.Poste</div>
        </div>
        <div class="row mb-2">
            <div class="col-3">Rôle :</div>
            <div class="col-9" name="Role">@Model.Role</div>
        </div>
        <div class="row mb-2">
            <div class="col-3">Date :</div>
            <div class="col-9" name="CreatedAt">@Model.CreatedAt</div>
        </div>
        <hr />
        <div>
            <button type="button" class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#EditProfileModal">
                Editer Profil
            </button>
            <a class="btn btn-outline-warning btn-sm" href="/Account/Password/@Model.Id">
                Editer Mot de passe
            </a>
        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="EditProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog ProfilUpdate">
        <div class="modal-content text-white">
            <div class="modal-header">
                <h2 class="modal-title fs-5">Editer mon Profil</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <div class="row mb-2">
                        <label class="col-4 col-form-label">Nom :</label>
                        <div class="col-8">
                            <input type="text" name="Name" id="Name" placeholder="Nom" class="form-control" value="@Model.Name" />
                            <span class="text-white">@Html.ValidationMessageFor(m => m.Name)</span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label class="col-4 col-form-label">Matricule :</label>
                        <div class="col-8">
                            <input type="text" name="Matricule" id="Matricule" placeholder="Matricule" class="form-control" value="@Model.Matricule" />
                            <span class="text-white">@Html.ValidationMessageFor(m => m.Matricule)</span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label class="col-4 col-form-label">Email :</label>
                        <div class="col-8">
                            <input type="text" name="Email" id="Email" placeholder="Email" class="form-control" value="@Model.Email" />
                            <span class="text-white">@Html.ValidationMessageFor(m => m.Email)</span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label class="col-4 col-form-label">Téléphone :</label>
                        <div class="col-8">
                            <input type="text" name="Phone" id="Phone" placeholder="Phone" class="form-control" value="@Model.Phone" />
                            <span class="text-white">@Html.ValidationMessageFor(m => m.Phone)</span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label class="col-4 col-form-label">Adresse :</label>
                        <div class="col-8">
                            <input type="text" name="Address" id="Address" placeholder="Adresse" class="form-control" value="@Model.Address" />
                            <span class="text-white">@Html.ValidationMessageFor(m => m.Address)</span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label class="col-4 col-form-label">Poste :</label>
                        <div class="col-8">
                            <select name="Poste" class="form-control" id="Poste">
                                @{ foreach (var poste in ViewBag.Poste)
                                    {
                                        <option value="@poste" @(poste == Model.Poste ? "selected" : "")>@poste</option>
                                    }
                                }
                            </select>
                            <span class="text-white">@Html.ValidationMessageFor(m => m.Poste)</span>
                        </div>
                    </div>
                    <input type="hidden" name="Role" id="Role" class="form-control" value="@Model.Role" />
                    <input type="hidden" name="CreatedAt" id="CreatedAt" class="form-control" value="@Model.CreatedAt" />
                    <input type="hidden" name="Password" id="Password" class="form-control" value="@Model.Password" />
                    <div class="row mb-4 offset-6 col-4 btn-save">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Sauvegarder</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Vérifiez si ViewBag.HasErrors est vrai
        var hasErrors = @((ViewBag.HasErrors ?? false).ToString().ToLower());
        if (hasErrors) {
            $('#EditProfileModal').modal('show');
        }
    });
</script>
