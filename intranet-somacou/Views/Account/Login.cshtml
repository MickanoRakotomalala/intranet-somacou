
@{
    ViewBag.Title = "Login";
}


<div class="container-fluid">
    <div class="offset-lg-4 col-lg-4 offset-lg-4 offset-md-4 col-md-4 offset-md-4 col-sm-12 login">
        <form action="/Account/Login" method="post">
            <h3>Se connecter</h3>
            @if(ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">            
                    <Strong>@ViewBag.ErrorMessage</Strong>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <input class="form-control" type="email" placeholder="Entrer votre Email" name="Email" id="Email" value="@Request.Form["Email"]"/>
            <input class="form-control" type="password" placeholder="Entrer votre Mot de passe" name="Password" id="Password" value="@Request.Form["Password"]"/>

            <button type="submit" class="btn btn-outline-primary mt-3">Se connecter</button>
        </form>
    </div>
</div>

