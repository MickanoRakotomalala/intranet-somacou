<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Somacou</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="~/Assets/logo-somacou.png" rel="shortcut icon" image="image x-icon" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="~/Scripts/bootstrap.min.js" rel="stylesheet" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js" integrity="sha384-9/reFTGAW83EW2RDu2S0VKaIzap3H66lZH81PoYlFhbGU+6BZp6G7niu735Sk7lN" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.min.js" integrity="sha384-+sLIOodYLS7CIrQpBjl+C7nPvqq+FbNUBDunl/OZv93DB7Ln/533i8e/mZXLi/P+" crossorigin="anonymous"></script>
    <script src="~/Scripts/active.js" defer></script>
    <script src="~/Scripts/menu.js" defer></script>
    <script src="~/Scripts/index.js" defer></script>
    @*<script src="~/Scripts/Validate.js" defer></script>*@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/typed.js/2.0.12/typed.min.js"
            referrerpolicy="no-referrer">
    </script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

</head>
<body class="body">
    <nav class="navbar navbar-expand-xl navbar-toggleable-xl navbar-dark bg-danger fixed-top">
        <div class="container-fluid">
            @Html.ActionLink("SOMACOU", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Activer/désactiver la navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-xl-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        @Html.ActionLink("Accueil", "Index", "Home", new { area = "" }, new { @id = "link-home", @class = "nav-link" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Dsi", "Dsi", "Home", new { area = "" }, new { @id = "link-dsi", @class = "nav-link" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Architecture", "Architecture", "Device", new { area = "" }, new { @id = "link-commercial", @class = "nav-link" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Matériel", "Matériel", "Device", new { area = "" }, new { @id = "link-magasin", @class = "nav-link" })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("Responsable", "Responsable", "Device", new { area = "" }, new { @id = "link-usine", @class = "nav-link" })
                    </li>
                </ul>
                <ul class="navbar-nav">
                    @if (Session["UserId"] != null)
                    {
                        if (Session["Role"].ToString() == "Admin")
                        {
                            <li class="Session dropdown">
                                <span class="dropdown-toggle" role="button" data-toggle="dropdown" aria-expanded="false">
                                    @(Session["FullName"] + " " + "(Admin)")
                                </span>
                                <ul class="dropdown-menu dropdown-menu-end mt-4">
                                    <li><a class="dropdown-item" href="/Users/Index"><i class="bi bi-people me-2"></i>Utilisateurs</a></li>
                                    <li><a class="dropdown-item" href="/Account/Profile"><i class="bi bi-person-circle me-2"></i>Profil</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>Se déconnecter</a></li>
                                </ul>
                            </li>
                        }
                        else if (Session["Role"].ToString() == "Chef")
                        {

                            <li class="Session dropdown">
                                <span class="dropdown-toggle" role="button" data-toggle="dropdown" aria-expanded="false">
                                    @(Session["FullName"] + " " + "(Chef)")
                                </span>
                                <ul class="dropdown-menu dropdown-menu-end mt-4">
                                    <li><a class="dropdown-item" href="/Account/Profile"><i class="bi bi-person-circle me-2"></i>Profil</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>Se déconnecter</a></li>
                                </ul>
                            </li>
                        }
                        else if (Session["Role"].ToString() == "User")
                        {
                            <li class="Session dropdown">
                                <span class="dropdown-toggle" role="button" data-toggle="dropdown" aria-expanded="false">
                                    @(Session["FullName"] + " " + "(User)")
                                </span>
                                <ul class="dropdown-menu dropdown-menu-end mt-4">
                                    <li><a class="dropdown-item" href="/Account/Profile"><i class="bi bi-person-circle me-2"></i>Profil</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>Se déconnecter</a></li>
                                </ul>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="log">
                            <a class="account-log me-2" href="~/Account/Register">S'inscrire &nbsp;<i class="bi bi-person"></i></a>
                        </li>
                        <li class="log">
                            <a class="account-log me-2" href="~/Account/Login">Se Connecter &nbsp;<i class="bi bi-box-arrow-in-right"></i></a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <div class="container-fluid body-content">
        @RenderBody()
    </div>
    <footer class="container-fluid fixed">
        <div class="container">
            <div class="row">
                <div class="col-md-6 col-sm-6">
                    <div class="row">
                        <div class="col-4">
                            <img src="~/Assets/logo-somacou.png" alt="logo smc" />
                        </div>
                        <div class="col-8">
                                <p><i class="bi bi-house-check me-2"></i><span>Pk 08 Route d’AMBOHIMANGA ILAFY</span></p>
                                <p><i class="bi bi-signpost me-2"></i><span>Antananarivo Madagascar</span></p>     
                                <p><i class="bi bi-house-gear me-2"></i><span>Entreprise Textile</span></p>     
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-sm-6">
                    <label>RÉSEAUX SOCIAUX</label>
                    <ul>
                        <li class="me-3"><a href="https://www.facebook.com/somacoucouleurvanill" target="_blank"><i class="bi bi-facebook"></i></a></li>
                        <li class="me-3"><a href="https://www.linkedin.com/in/nantenaina-mickano-rakotomalala-55a3a11ab" target="_blank"><i class="bi bi-linkedin"></i></a></li>
                        <li class="me-3"><a href="https://wa.me/+261341029531" target="_blank"><i class="bi bi-whatsapp"></i></a></li>
                        <li class="me-5"><a href="mailto:rakotomalalamickano@gmail.com" target="_blank"><i class="bi bi-envelope"></i></a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="container">
            <hr />
            <div class="Developer">
                <p>&copy; @DateTime.Now.Year - Developer : Mickano RAKOTOMALALA</p>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
