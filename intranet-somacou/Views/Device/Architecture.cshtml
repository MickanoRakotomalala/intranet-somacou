
@{
    ViewBag.Title = "Intranet";
}

<div class="container-fluid">
    <div>
        <img src="~/Assets/DSI.PNG" alt="DSI" />
    </div>
    <div class="row">
        <div class="col-xl-2 col-lg-12 mx-auto DsiMenu">
            <div class="MainMenu">
                <div class="Menu">
                    <h5 class="menuactive" id="menunetwork" type="button" data-bs-toggle="collapse" data-bs-target="#network" aria-expanded="false" aria-controls="dsi"><i class="bi bi-router me-2"></i><span>Réseaux</span></h5>
                    <ul class="collapse" id="network">
                        <li class="listactive" id="snetworkd" onclick="shownetworkd()"><i class="bi bi-textarea me-2"></i><a href="#networkd">Détails</a></li>
                        <li id="snetworkimg" onclick="shownetworkimg()"><i class="bi bi-image me-2"></i><a href="#networkimg">Image</a></li>
                    </ul>
                </div>
                <div class="Menu">
                    <h5 type="button" data-bs-toggle="collapse" data-bs-target="#soft_hard" aria-expanded="false" aria-controls="soft_hard"><i class="bi bi-camera me-2"></i><span>Caméras</span></h5>
                    <ul class="collapse" id="soft_hard">
                        <li><i class="bi bi-textarea me-2"></i><a href="#">Détails</a></li>
                        <li><i class="bi bi-image me-2"></i><a href="#">Image</a></li>
                    </ul>
                </div>
            </div>
        </div>

        @*DSI*@
        <div class=" offset-1 col-xl-9 col-lg-12 mx-auto" id="networkd">
            <h5><i class="bi bi-textarea me-2"></i>Réseaux Informatique</h5>
            <div class="row">
                <div class="col-md-6">
                    <h6><i class="bi bi-question-circle me-2"></i>Pourquoi utiliser un réseau dans une entreprise ?</h6>
                    <ol>
                        <li>
                            <p>Partage des ressources :</p>
                            <ul>
                                <li>Imprimantes, scanners, disques durs, serveurs, etc.</li>
                                <li>Évite d’acheter du matériel pour chaque poste.</li>
                            </ul>
                        </li>
                        <li>
                            <p>Facilite la communication :</p>
                            <ul>
                                <li>Messagerie interne, e-mails, visioconférences.</li>
                                <li>Collaboration en temps réel (ex. : Microsoft Teams, Slack).</li>
                            </ul>
                        </li>
                        <li>
                            <p>Partage de fichiers et de données :</p>
                            <ul>
                                <li>Accès centralisé aux fichiers via un serveur ou un NAS.</li>
                                <li>Gestion des autorisations (accès par service, rôle, etc.).</li>
                            </ul>
                        </li>
                        <li>
                            <p>Sécurité et sauvegarde :</p>
                            <ul>
                                <li>Centralisation des données sur des serveurs sécurisés.</li>
                                <li>Sauvegardes automatiques.</li>
                                <li>Protection contre les intrusions (pare-feu, antivirus, etc.).</li>
                            </ul>
                        </li>
                        <li>
                            <p>Accès à Internet partagé :</p>
                            <ul>
                                <li>Tous les postes accèdent à Internet via une seule connexion contrôlée.</li>
                            </ul>
                        </li>
                        <li>
                            <p>Gestion centralisée des utilisateurs :</p>
                            <ul>
                                <li>
                                    Grâce à des solutions comme Active Directory, 
                                    on peut gérer les comptes utilisateurs, les droits d'accès, 
                                    les stratégies de sécurité, etc.
                                </li>
                            </ul>
                        </li>
                        <li>
                            <p>Productivité accrue :</p>
                            <ul>
                                <li>Moins de déplacements pour échanger des documents.</li>
                                <li>Meilleur suivi des activités et des performances.</li>
                            </ul>
                        </li>
                    </ol>
                </div>
                <div class="offset-md-1 col-md-5">
                    <h6><i class="bi bi-list-check me-2"></i>Types de réseaux utilisés dans une entreprise :</h6>
                    <div class="table-network">
                        <table class="table table-responsive-md">
                            <thead>
                                <tr>
                                    <th>Type de Réseau</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>LAN (Local Area Network)</td>
                                    <td>Réseau local, utilisé à l’intérieur d’un même bâtiment.</td>
                                </tr>
                                <tr>
                                    <td>WAN (Wide Area Network)</td>
                                    <td>Réseau étendu (ex. : relier plusieurs sites géographiques).</td>
                                </tr>
                                <tr>
                                    <td>VPN (Virtual Private Network)</td>
                                    <td>Connexion sécurisée entre l’entreprise et des utilisateurs à distance.</td>
                                </tr>
                                <tr>
                                    <td>WLAN (Wirelesse LAN)</td>
                                    <td>Réseau sans fil (Wi-Fi dans les bureaux).</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <h6><i class="bi bi-tools me-2"></i>Éléments clés d’un réseau d’entreprise</h6>
                    <div>
                        <ul>
                            <li>Serveurs (fichiers, bases de données, messagerie, web, etc.)</li>
                            <li>Switchs et routeurs</li>
                            <li>Pare-feu et systèmes de sécurité</li>
                            <li>Câblage (Ethernet, fibre optique, etc.)</li>
                            <li>Points d’accès Wi-Fi</li>
                            <li>Postes clients (PC, laptops, smartphones, etc.)</li>
                        </ul>
                    </div>

                    <h6><i class="bi bi-shield-lock me-2"></i>Sécurité dans un réseau d’entreprise :</h6>
                    <div>
                        <ul>
                            <li>Authentification des utilisateurs</li>
                            <li>Segmentation réseau (VLAN)</li>
                            <li>Sauvegardes régulières</li>
                            <li>Surveillance du trafic réseau</li>
                            <li>Mises à jour régulières des systèmes</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="offset-1 col-xl-9 col-lg-12 mx-auto" id="networkimg" hidden>
            <h5><i class="bi bi-image me-2"></i> ARCHITECTURE RÉSEAUX SOMACOU</h5>
            <div>
                <img src="~/Assets/Network_Architect_SOMACOU.PNG" alt="Architect Network" />
            </div>
            <p>
                <h6>Description : </h6>
                <ul>
                    <li>Source connexion internet : Fibre optique YAS Madagascar</li>
                    <li>Matériel : Router Mikrotik(Yas)</li>
                    <li>Configuration Router DHCP</li>
                    <li>Type d'architecture réseaux : Cascade</li>
                    <li>Nombres de Switch utilisé (18)</li>
                    <li>Nombres de Poste (25) et Serveur (2)</li>
                </ul>
            </p>
        </div>

        @*INCIDENT*@
        <div class="offset-1 col-xl-9 col-lg-12 mx-auto" id="addinc" hidden>
            <div class="row offset-2 col-8 offset-2">
                <h5><i class="bi bi-plus-circle me-2"></i>DEMANDE D'INTERVENTION :</h5>
                <div class="container-fluid p-2">
                    <form id="incidentForm" action="Dsi#addinc" method="post">
                        @*<input type="hidden" name="Id" id="Id" />*@
                        <input type="hidden" name="UserName" id="UserName" value="@Session["FullName"].ToString()" class="form-control" />
                        <div class="row mb-2">
                            <label class="offset-sm-2 col-sm-2 col-form-label">Type :</label>
                            <div class="col-sm-8">
                                <select name="Type" id="Type" class="form-control">
                                    <option value="Matériel">Panne matériel</option>
                                    <option value="Logiciel">Panne logiciel</option>
                                    <option value="Réseaux">Panne réseaux</option>
                                    <option value="Périphérique">Panne périphérique</option>
                                    <option value="Performance">Panne performance</option>
                                    <option value="Sauvegarde">Panne sauvegarde</option>
                                    <option value="Autre">Autre Panne</option>
                                </select>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label class="offset-2 col-sm-2 col-form-label">Détails :</label>
                            <div class="col-sm-8">
                                <Textarea name="Details" id="Details" class="form-control"></Textarea>
                            </div>
                        </div>
                        <div class="row mb-2" hidden>
                            <label class="col-sm-4 col-form-label">Statut</label>
                            <div class="col-sm-8">
                                <select name="Etat" id="Etat" class="form-control">
                                    <option value="Nouveau">Nouveau</option>
                                </select>
                            </div>
                        </div>


                        <div class="row mb-4 offset-sm-4 col-sm-4 offset-sm-4">
                            <button type="submit" class="btn btn-outline-warning offset-sm-4 col-sm-8">Soumettre</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="offset-1 col-xl-9 col-lg-12 mx-auto" id="listInc" hidden>
            <h5><i class="bi bi-list-task me-2"></i>LISTE INCIDENT</h5>
            <div class="table-responsive-sm">
                <table class="table table-responsive-sm" id="incidentTable">
                    <thead>
                        <tr>
                            <th>Utilisateur</th>
                            <th>Contact</th>
                            <th>Type</th>
                            <th>Détails</th>
                            <th>Création</th>
                            <th>Statut</th>
                            <th>Réalisation</th>
                            <th>Responsable</th>
                            <th>Observation</th>
                            @if ((Session["Role"].ToString() == "Admin" || Session["Role"].ToString() == "Chef")
                                && (Session["Poste"].ToString() == "Developer" || Session["Poste"].ToString() == "HelpDesk"))
                            {
                                <th></th>
                            }
                            @if (Session["Role"].ToString() == "Admin")
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Les données seront injectées ici via JavaScript -->
                    </tbody>
                </table>
            </div>
            <nav aria-label="Page navigation" class="container paginationIncident">
                <ul class="pagination">
                    @*Les données seront ajoutées ici dynamiquement par AJAX de Javascript*@
                </ul>
            </nav>
        </div>
    </div>
</div>


