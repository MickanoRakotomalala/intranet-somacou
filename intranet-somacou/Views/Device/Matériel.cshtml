
@{
    ViewBag.Title = "Intranet";
}

<div class="container-fluid">
    <div>
        <img src="~/Assets/DSI.PNG" alt="DSI" />
    </div>
    <div class="row">
        <div class="col-xl-2 col-lg-12 mx-auto DsiMenu">
            <div class="MainMenu">
                <div class="Menu">
                    <h5 class="menuactive" id="menumateriel" type="button" data-bs-toggle="collapse" data-bs-target="#materiel" aria-expanded="false" aria-controls="dsi"><i class="bi bi-pc-display-horizontal me-2"></i><span>Matériel</span></h5>
                    <ul class="collapse" id="materiel">
                        <li class="listactive" id="smaterield" onclick="showMaterielD()"><i class="bi bi-textarea me-2"></i><a href="#materield">Description</a></li>
                        <li id="snewmateriel" onclick="showNewMateriel()"><i class="bi bi-plus-circle me-2"></i><a href="#newmateriel">Nouveau</a></li>
                        <li id="slistmateriel" onclick="showListMateriel()"><i class="bi bi-view-list me-2"></i><a href="#listmateriel">Liste</a></li>
                    </ul>
                </div>
            </div>
        </div>

        @*DSI*@
        <div class=" offset-1 col-xl-9 col-lg-12 mx-auto" id="materield">
            <h5><i class="bi bi-textarea me-2"></i>Matériels Informatiques</h5>
            <div class="row">
                <div class="col-md-6">
                    <h6><i class="bi bi-pc-display me-2"></i>Postes de travail</h6>
                    <div class="table-network">
                        <table class="table table-responsive-md">
                            <thead>
                                <tr>
                                    <th>Matériel</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Ordinateurs de bureau (PC) :</td>
                                    <td>Utilisés par les employés pour leurs tâches quotidiennes (bureautique, email, applications métiers).</td>
                                </tr>
                                <tr>
                                    <td>Ordinateurs portables :</td>
                                    <td>Pour les utilisateurs nomades ou en télétravail. Plus mobiles mais parfois moins puissants que les PC fixes.</td>
                                </tr>
                                <tr>
                                    <td>Stations de travail (Workstations)</td>
                                    <td>Ordinateurs très puissants, utilisés pour des traitements lourds (graphisme, modélisation 3D, développement logiciel, etc.).</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <h6><i class="bi bi-display me-2"></i>Périphériques</h6>
                    <div class="table-network">
                        <table class="table table-responsive-md">
                            <thead>
                                <tr>
                                    <th>Matériel</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Écrans/Moniteurs :</td>
                                    <td>Un ou plusieurs écrans sont connectés à chaque ordinateur selon les besoins.</td>
                                </tr>
                                <tr>
                                    <td>Imprimantes et photocopieurs :</td>
                                    <td>Partagés ou individuels, utilisés pour l’impression de documents internes ou externes.</td>
                                </tr>
                                <tr>
                                    <td>Scanners :</td>
                                    <td>Pour la numérisation de documents physiques.</td>
                                </tr>
                                <tr>
                                    <td>Claviers et souris :</td>
                                    <td>Accessoires de saisie standards.</td>
                                </tr>
                                <tr>
                                    <td>Casques, webcams, micros :</td>
                                    <td>Utilisés pour la communication (visioconférences, appels Teams, etc.).</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <h6><i class="bi bi-router me-2"></i>Équipements réseau</h6>
                    <div class="table-network">
                        <table class="table table-responsive-md">
                            <thead>
                                <tr>
                                    <th>Matériel</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Routeur :</td>
                                    <td>Permet d’interconnecter le réseau local (LAN) avec Internet.</td>
                                </tr>
                                <tr>
                                    <td>Switchs :</td>
                                    <td>Distribuent la connexion réseau entre les différents équipements.</td>
                                </tr>
                                <tr>
                                    <td>Points d’accès Wi-Fi :</td>
                                    <td>Permettent une connexion sans fil aux ordinateurs portables, smartphones ou tablettes.</td>
                                </tr>
                                <tr>
                                    <td>Câblage réseau (Ethernet) :</td>
                                    <td>Pour les connexions filaires.</td>
                                </tr>
                                <tr>
                                    <td>Firewall matériel :</td>
                                    <td>Protège le réseau contre les intrusions extérieures.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="offset-md-1 col-md-5">
                    <h6><i class="bi bi-server me-2"></i>Serveurs</h6>
                    <div class="table-network">
                        <table class="table table-responsive-md">
                            <thead>
                                <tr>
                                    <th>Matériel</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Serveurs de fichiers :</td>
                                    <td>Stockage et partage des documents entre utilisateurs.</td>
                                </tr>
                                <tr>
                                    <td>Serveurs d’applications :</td>
                                    <td>Hébergent les logiciels métier (ERP, CRM, etc.).</td>
                                </tr>
                                <tr>
                                    <td>Serveurs de messagerie :</td>
                                    <td>Gèrent les emails professionnels (ex. Exchange Server).</td>
                                </tr>
                                <tr>
                                    <td>Serveurs de base de données :</td>
                                    <td>Contiennent les données structurées (SQL Server, MySQL…).</td>
                                </tr>
                                <tr>
                                    <td>Serveurs de virtualisation :</td>
                                    <td>Hébergent plusieurs machines virtuelles sur un seul serveur physique (VMware, Hyper-V).</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <h6><i class="bi bi-tools me-2"></i>Matériels de sécurité et sauvegarde</h6>
                    <div class="table-network">
                        <table class="table table-responsive-md">
                            <thead>
                                <tr>
                                    <th>Matériel</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Onduleurs (UPS) :</td>
                                    <td>Assurent une alimentation de secours en cas de coupure électrique.</td>
                                </tr>
                                <tr>
                                    <td>Systèmes de sauvegarde (NAS, bandes magnétiques, disques durs externes) :</td>
                                    <td>Pour éviter la perte de données.</td>
                                </tr>
                                <tr>
                                    <td>Caméras de vidéosurveillance IP :</td>
                                    <td>Sécurisent les locaux.</td>
                                </tr>
                                <tr>
                                    <td>Contrôles d’accès (badge, biométrie) :</td>
                                    <td>Sécurisent l’accès aux salles informatiques.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <h6><i class="bi bi-motherboard me-2"></i>Autres équipements spécifiques</h6>
                    <div class="table-network">
                        <table class="table table-responsive-md">
                            <thead>
                                <tr>
                                    <th>Matériel</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Tablettes professionnelles :</td>
                                    <td>Pour la mobilité (commerciaux, techniciens).</td>
                                </tr>
                                <tr>
                                    <td>Smartphones d’entreprise :</td>
                                    <td>Pour la communication mobile.</td>
                                </tr>
                                <tr>
                                    <td>Tableaux interactifs / vidéoprojecteurs :</td>
                                    <td>Utilisés en salles de réunion ou de formation.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="offset-1 col-xl-9 col-lg-12 mx-auto" id="newmateriel" hidden>
            <h5><i class="bi bi-image me-2"></i> ARCHITECTURE RÉSEAUX SOMACOU</h5>
            <div>
                <img src="~/Assets/Network_Architect_SOMACOU.PNG" alt="Architect Network" />
            </div>
            <p>
                <h6>Description : </h6>
                <ul>
                    <li>Source connexion internet : Fibre optique YAS Madagascar</li>
                    <li>Matériel : Router Mikrotik(Yas)</li>
                    <li>Configuration Router : Protocole DHCP</li>
                    <li>Type d'architecture réseaux : Cascade</li>
                    <li>Nombres de Switch utilisé (18)</li>
                    <li>Nombres de Poste (25) et Serveur (2)</li>
                </ul>
            </p>
        </div>
        <div class="offset-1 col-xl-9 col-lg-12 mx-auto" id="listmateriel" hidden>
            <h5><i class="bi bi-image me-2"></i> ARCHITECTURE RÉSEAUX SOMACOU</h5>
            <div>
                <img src="~/Assets/Network_Architect_SOMACOU.PNG" alt="Architect Network" />
            </div>
            <p>
                <h6>Description : </h6>
                <ul>
                    <li>Source connexion internet : Fibre optique YAS Madagascar</li>
                    <li>Matériel : Router Mikrotik(Yas)</li>
                    <li>Configuration Router : Protocole DHCP</li>
                    <li>Type d'architecture réseaux : Cascade</li>
                    <li>Nombres de Switch utilisé (18)</li>
                    <li>Nombres de Poste (25) et Serveur (2)</li>
                </ul>
            </p>
        </div>
    </div>
</div>

